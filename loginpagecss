.login-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: #101c2c url("./assets/tartan-bg.png") center / cover no-repeat;
  font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
}

.login-card {
  width: 100%;
  max-width: 380px;
  background: #16273a;
  border: 1px solid #2f4a63;
  border-radius: 14px;
  padding: 40px 32px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
}

.login-logo {
  display: block;
  height: 64px;
  width: auto;
  margin-bottom: 24px;
}

.login-title {
  font-size: 22px;
  font-weight: 600;
  color: #f5f1e8;
  margin: 0 0 6px;
}

.login-subtitle {
  font-size: 14px;
  color: #93a8bd;
  margin: 0 0 28px;
  line-height: 1.5;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.login-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 13px;
  color: #b7c5d3;
}

.login-field input {
  font-size: 15px;
  padding: 11px 13px;
  border-radius: 8px;
  border: 1px solid #35516a;
  background: #0f1c2c;
  color: #f5f1e8;
  outline: none;
  transition: border-color 0.15s ease;
}

.login-field input:focus-visible {
  border-color: #c17a4a;
}

.login-password-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.login-password-wrap input {
  width: 100%;
  padding-right: 74px;
}

.login-toggle {
  position: absolute;
  right: 10px;
  background: none;
  border: none;
  color: #d18e5c;
  font-size: 12px;
  cursor: pointer;
  padding: 4px 6px;
}

.login-toggle:focus-visible {
  outline: 2px solid #c17a4a;
  border-radius: 4px;
}

.login-error {
  margin: 0;
  font-size: 13px;
  color: #e08a6a;
}

.login-submit {
  margin-top: 4px;
  padding: 12px;
  border-radius: 8px;
  border: none;
  background: #b5651d;
  color: #f5f1e8;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease;
}

.login-submit:hover {
  background: #c17a4a;
}

.login-submit:focus-visible {
  outline: 2px solid #f5f1e8;
  outline-offset: 2px;
}

.login-forgot {
  display: block;
  text-align: center;
  margin-top: 20px;
  font-size: 13px;
  color: #93a8bd;
  text-decoration: none;
}

.login-forgot:hover {
  color: #b7c5d3;
  text-decoration: underline;
}

.login-signup {
  margin: 16px 0 0;
  text-align: center;
  font-size: 13px;
  color: #93a8bd;
}

.login-signup-link {
  background: none;
  border: none;
  padding: 0;
  color: #d18e5c;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}

.login-signup-link:hover {
  text-decoration: underline;
}

@media (prefers-reduced-motion: reduce) {
  .login-submit,
  .login-toggle {
    transition: none;
  }
}
