.card-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: #101c2c;
  background-image: radial-gradient(circle at 20% 20%, #1b2f45 0%, #101c2c 55%);
  font-family: "Inter", "Helvetica Neue", Arial, sans-serif;
}

.card-card {
  width: 100%;
  max-width: 420px;
  background: #16273a;
  border: 1px solid #2f4a63;
  border-radius: 14px;
  padding: 40px 32px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
}

.card-title {
  font-size: 22px;
  font-weight: 600;
  color: #f5f1e8;
  margin: 0 0 6px;
}

.card-subtitle {
  font-size: 14px;
  color: #93a8bd;
  margin: 0 0 28px;
  line-height: 1.5;
}

.card-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.card-row {
  display: flex;
  gap: 14px;
}

.card-row .card-field {
  flex: 1;
}

.card-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 13px;
  color: #b7c5d3;
}

.card-field input,
.card-field select {
  font-size: 15px;
  padding: 11px 13px;
  border-radius: 8px;
  border: 1px solid #35516a;
  background: #0f1c2c;
  color: #f5f1e8;
  outline: none;
  transition: border-color 0.15s ease;
  font-family: inherit;
}

.card-field select {
  appearance: none;
  background-image: linear-gradient(45deg, transparent 50%, #93a8bd 50%),
    linear-gradient(135deg, #93a8bd 50%, transparent 50%);
  background-position: calc(100% - 18px) center, calc(100% - 13px) center;
  background-size: 5px 5px, 5px 5px;
  background-repeat: no-repeat;
}

.card-field input:focus-visible,
.card-field select:focus-visible {
  border-color: #c17a4a;
}

.card-error {
  margin: 0;
  font-size: 13px;
  color: #e08a6a;
}

.card-submit {
  margin-top: 4px;
  padding: 12px;
  border-radius: 8px;
  border: none;
  background: #b5651d;
  color: #f5f1e8;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.15s ease;
}

.card-submit:hover {
  background: #c17a4a;
}

.card-submit:focus-visible {
  outline: 2px solid #f5f1e8;
  outline-offset: 2px;
}
