// ---------- Inventario ----------
const formInventario = document.getElementById("form-inventario");
formInventario.addEventListener("submit", (e) => {
  e.preventDefault();
  const stock = Number(document.getElementById("i-stock").value);
  const costo = Number(document.getElementById("i-costo").value);
  const precio = Number(document.getElementById("i-precio").value);
  data.inventario.push({
    id: uid(),
    producto: document.getElementById("i-producto").value,
    categoria: document.getElementById("i-categoria").value,
    stock,
    costo,
    precio,
  });
  saveData();
  formInventario.reset();
  renderAll();
});

function renderInventario() {
  const tbody = document.getElementById("tbl-inventario");
  tbody.innerHTML = "";
  document.getElementById("empty-inventario").style.display = data.inventario.length ? "none" : "block";

  data.inventario.forEach((i) => {
    const valorCosto = i.stock * i.costo;
    const valorVenta = i.stock * i.precio;
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td>${escapeHtml(i.producto)}</td>
      <td>${escapeHtml(i.categoria)}</td>
      <td>${i.stock}</td>
      <td>${money(i.costo)}</td>
      <td>${money(i.precio)}</td>
      <td>${money(valorCosto)}</td>
      <td>${money(valorVenta)}</td>
      <td><button class="row-delete" data-id="${i.id}">Eliminar</button></td>
    `;
    tbody.appendChild(tr);
  });

  tbody.querySelectorAll(".row-delete").forEach((btn) => {
    btn.addEventListener("click", () => {
      data.inventario = data.inventario.filter((i) => i.id !== btn.dataset.id);
      saveData();
      renderAll();
    });
  });
}

// ---------- Balance ----------
const balanceInputIds = ["b-caja", "b-cxc", "b-cxp", "b-deuda", "b-capital"];
const balanceInputKeys = { "b-caja": "caja", "b-cxc": "cxc", "b-cxp": "cxp", "b-deuda": "deuda", "b-capital": "capital" };

balanceInputIds.forEach((id) => {
  document.getElementById(id).addEventListener("input", (e) => {
    data.balanceInputs[balanceInputKeys[id]] = Number(e.target.value) || 0;
    saveData();
    renderBalance();
  });
});

function totalVentas() {
  return data.ventas.reduce((s, v) => s + v.total, 0);
}

function totalGastos() {
  return data.gastos.reduce((s, g) => s + g.monto, 0);
}

function totalInventarioCosto() {
  return data.inventario.reduce((s, i) => s + i.stock * i.costo, 0);
}

function renderBalance() {
  const ventas = totalVentas();
  const gastos = totalGastos();
  const utilidad = ventas - gastos;
  const invCosto = totalInventarioCosto();
  const { caja, cxc, cxp, deuda, capital } = data.balanceInputs;

  document.getElementById("ts-ventas").textContent = money(ventas);
  document.getElementById("ts-gastos").textContent = money(gastos);
  document.getElementById("ts-utilidad").textContent = money(utilidad);

  document.getElementById("b-ventas").textContent = money(ventas);
  document.getElementById("b-gastos").textContent = money(gastos);
  document.getElementById("b-utilidad").textContent = money(utilidad);
  document.getElementById("b-utilidad2").textContent = money(utilidad);
  document.getElementById("b-inventario").textContent = money(invCosto);

  document.getElementById("b-caja").value = caja;
  document.getElementById("b-cxc").value = cxc;
  document.getElementById("b-cxp").value = cxp;
  document.getElementById("b-deuda").value = deuda;
  document.getElementById("b-capital").value = capital;

  const totalActivos = caja + invCosto + cxc;
  const totalPasivos = cxp + deuda;
  const totalPatrimonio = capital + utilidad;

  document.getElementById("b-total-activos").textContent = money(totalActivos);
  document.getElementById("b-total-pasivos").textContent = money(totalPasivos);
  document.getElementById("b-total-patrimonio").textContent = money(totalPatrimonio);

  const diferencia = totalActivos - (totalPasivos + totalPatrimonio);
  const checkCard = document.getElementById("check-card");
  document.getElementById("check-value").textContent = money(diferencia);
  if (Math.abs(diferencia) < 0.01) {
    checkCard.classList.add("ok");
    checkCard.classList.remove("off");
    document.getElementById("check-label").textContent = "Activos = Pasivos + Patrimonio ✓";
  } else {
    checkCard.classList.add("off");
    checkCard.classList.remove("ok");
    document.getElementById("check-label").textContent = "Activos ≠ Pasivos + Patrimonio, revisa tus datos";
  }
}

// ---------- Reset ----------
document.getElementById("btn-reset").addEventListener("click", () => {
  if (!confirm("¿Borrar todos los datos guardados en este navegador? Esta acción no se puede deshacer.")) return;
  localStorage.removeItem(STORAGE_KEY);
  data = loadData();
  renderAll();
});

// ---------- Helpers ----------
function escapeHtml(str) {
  if (str === undefined || str === null) return "";
  return String(str)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

function renderAll() {
  renderVentas();
  renderGastos();
  renderInventario();
  renderBalance();
}

renderAll();
