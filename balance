// ---------- Almacenamiento ----------
const STORAGE_KEY = "boutiqueBalanceData";

function loadData() {
  const raw = localStorage.getItem(STORAGE_KEY);
  if (!raw) {
    return {
      ventas: [],
      gastos: [],
      inventario: [],
      balanceInputs: { caja: 0, cxc: 0, cxp: 0, deuda: 0, capital: 0 },
    };
  }
  try {
    const parsed = JSON.parse(raw);
    parsed.ventas = parsed.ventas || [];
    parsed.gastos = parsed.gastos || [];
    parsed.inventario = parsed.inventario || [];
    parsed.balanceInputs = parsed.balanceInputs || { caja: 0, cxc: 0, cxp: 0, deuda: 0, capital: 0 };
    return parsed;
  } catch {
    return { ventas: [], gastos: [], inventario: [], balanceInputs: { caja: 0, cxc: 0, cxp: 0, deuda: 0, capital: 0 } };
  }
}

function saveData() {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
}

let data = loadData();

// ---------- Utilidades ----------
function money(n) {
  const v = Number(n) || 0;
  return v.toLocaleString("es-GT", { style: "currency", currency: "USD" });
}

function uid() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
}

// ---------- Navegación ----------
document.querySelectorAll(".nav-btn").forEach((btn) => {
  btn.addEventListener("click", () => {
    document.querySelectorAll(".nav-btn").forEach((b) => b.classList.remove("active"));
    document.querySelectorAll(".panel").forEach((p) => p.classList.remove("active"));
    btn.classList.add("active");
    document.getElementById(btn.dataset.section).classList.add("active");
  });
});

// ---------- Ventas ----------
const formVenta = document.getElementById("form-venta");
formVenta.addEventListener("submit", (e) => {
  e.preventDefault();
  const cantidad = Number(document.getElementById("v-cantidad").value);
  const precio = Number(document.getElementById("v-precio").value);
  data.ventas.push({
    id: uid(),
    fecha: document.getElementById("v-fecha").value,
    cliente: document.getElementById("v-cliente").value,
    categoria: document.getElementById("v-categoria").value,
    producto: document.getElementById("v-producto").value,
    cantidad,
    precio,
    total: cantidad * precio,
  });
  saveData();
  formVenta.reset();
  document.getElementById("v-cantidad").value = 1;
  renderAll();
});

function renderVentas() {
  const tbody = document.getElementById("tbl-ventas");
  tbody.innerHTML = "";
  document.getElementById("empty-ventas").style.display = data.ventas.length ? "none" : "block";

  data.ventas.forEach((v) => {
    const tr = document.createElement("tr");
    tr.innerHTML = `
      <td>${v.fecha || "—"}</td>
      <td>${escapeHtml(v.cliente)}</td>
      <td>${escapeHtml(v.categoria)}</td>
      <td>${escapeHtml(v.producto)}</td>
      <td>${v.cantidad}</td>
      <td>${money(v.precio)}</td>
      <td>${money(v.total)}</td>
      <td><button class="row-delete" data-id="${v.id}">Eliminar</button></td>
    `;
    tbody.appendChild(tr);
  });

  tbody.querySelectorAll(".row-delete").forEach((btn) => {
    btn.addEventListener("click", () => {
      data.ventas = data.ventas.filter((v) => v.id !== btn.dataset.id);
      saveData();
      renderAll();
    });
  });

  const categorias = ["Zapatos", "Bufandas", "Chaquetas"];
  const resumen = document.getElementById("resumen-ventas");
  resumen.innerHTML = categorias
    .map((cat) => {
      const total = data.ventas.filter((v) => v.categoria === cat).reduce((s, v) => s + v.total, 0);
      return `<div class="cat-pill"><span>${cat}</span><strong>${money(total)}</strong></div>`;
    })
    .join("");
}

